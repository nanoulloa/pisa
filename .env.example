# Pisa environment variables.
# .env.example is the committed template. Copy it to .env and fill in the values.
# .env is gitignored. Never commit real keys.

# --- Meta Model API (Muse Spark planner and explainer, SAM 3.1 tracking) ---
# Secret. Code reads the key only from this variable and never logs it.
MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
# Contributor tier: Meta may train on what we send. Our own test clips only, never user videos.
MUSE_SPARK_CONTRIBUTOR_MODEL=muse-spark-1.3-contributor
SAM_MODEL=sam-3.1

# --- Spend guard ---
# Kill switch. No code calls paid APIs while this is false.
# Set to true only after the $150 credits show under Billing > "free credits".
PISA_PAID_CALLS_ENABLED=false
# Meta's spend limit only sends email alerts. The engine stops calling paid APIs past this total (USD).
PISA_SPEND_CAP_USD=5

# --- WhatsApp Cloud API (Meta) ---
# Secret. Access token for the WhatsApp Business app (temporary token for testing, system user token later).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Secret. App secret, used to verify the X-Hub-Signature-256 header on incoming webhooks.
WHATSAPP_APP_SECRET=
# Secret. A random string we choose; Meta sends it back when verifying the webhook URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Graph API version shown in the Meta app dashboard.
WHATSAPP_GRAPH_API_VERSION=

# --- Supabase (jobs, results, video storage) ---
SUPABASE_URL=
# Safe to expose to the browser.
SUPABASE_PUBLISHABLE_KEY=
# Secret. Server only (engine and API routes). Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Modal (analysis jobs) ---
# Secret. Created with `modal token new`; needed for deploys and CI.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- App ---
# Public base URL used in result links and WhatsApp replies.
PISA_PUBLIC_URL=
# Engine API URL (Modal web endpoint) that the web app calls.
PISA_ENGINE_URL=
PISA_LOG_LEVEL=INFO
