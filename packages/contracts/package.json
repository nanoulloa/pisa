{
  "name": "@pisa/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from Pisa's JSON Schema contracts.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./schema/pisa.schema.json"
  },
  "scripts": {
    "gen": "node scripts/generate-ts.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.3"
  }
}
